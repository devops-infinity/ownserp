#!/usr/bin/env bash
set -Eeuo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO/tools/lib.sh"
require_bash 4.4

if ! command -v gitleaks >/dev/null 2>&1; then
	warn "gitleaks is not installed, so the staged secret scan was skipped"
	exit 0
fi

if gitleaks git --staged --redact --exit-code 1 >/dev/null 2>&1; then
	say SUCCESS "staged secret scan clean"
	exit 0
fi

say FAILED "a credential pattern is staged; fix it before committing"
gitleaks git --staged --redact || true
exit 1
