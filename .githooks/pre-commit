#!/usr/bin/env bash
set -Eeuo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO/tools/lib.sh"
require_bash 4.4

if ! command -v gitleaks >/dev/null 2>&1; then
	log_line FAILED "gitleaks is required for the commit secret scan; install it with: brew install gitleaks"
	exit 1
fi

if gitleaks git --staged --redact --config "$REPO/.gitleaks.toml" --exit-code 1 >/dev/null 2>&1; then
	log_line SUCCESS "staged secret scan clean"
	exit 0
fi

log_line FAILED "a credential pattern is staged; fix it before committing"
gitleaks git --staged --redact --config "$REPO/.gitleaks.toml" || true
exit 1
