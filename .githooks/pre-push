#!/usr/bin/env bash
set -Eeuo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO/tools/lib.sh"

if [[ -n "$(git -C "$REPO" status --porcelain)" ]]; then
	log_line FAILED "the working tree is not clean; the gate must run on the commits being pushed, so commit or stash first"
	exit 1
fi

log_line INFO "running the gate before push"
exec "$REPO/tools/verify.sh"
