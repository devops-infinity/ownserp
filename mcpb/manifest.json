{
  "manifest_version": "0.3",
  "name": "ownserp",
  "display_name": "OwnSERP",
  "version": "2.2.0",
  "description": "Serper.dev search tools for MCP clients, with credit accounting",
  "author": {
    "name": "Md. Sazzad Hossain Sharkar",
    "email": "sazzad@devops.bd",
    "url": "https://github.com/devops-infinity/ownserp"
  },
  "server": {
    "type": "binary",
    "entry_point": "server/ownserp",
    "mcp_config": {
      "command": "${__dirname}/server/ownserp",
      "args": [
        "serve"
      ],
      "env": {
        "SERPER_API_KEY": "${user_config.serper_api_key}"
      }
    }
  },
  "user_config": {
    "serper_api_key": {
      "type": "string",
      "title": "Serper API key",
      "description": "Issued at https://serper.dev/api-keys and stored in the OS keychain by the host",
      "sensitive": true,
      "required": true
    }
  },
  "compatibility": {
    "platforms": [
      "linux"
    ]
  }
}
