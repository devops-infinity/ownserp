{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.devops-infinity/ownserp",
  "description": "MCP server for the Serper.dev search API with per-call credit accounting",
  "title": "OwnSERP",
  "websiteUrl": "https://github.com/devops-infinity/ownserp",
  "repository": {
    "url": "https://github.com/devops-infinity/ownserp",
    "source": "github"
  },
  "version": "0.1.4",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@devops-infinity/ownserp",
      "version": "0.1.4",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ],
      "environmentVariables": [
        {
          "name": "SERPER_API_KEY",
          "description": "Serper.dev API key, issued at https://serper.dev/api-keys",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
